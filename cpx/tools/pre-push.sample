#!/bin/sh
# CPX 카드 점검 — 푸시 전에 다섯 검사기를 돌린다.
#
# 설치:
#   cp cpx/tools/pre-push.sample .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# 해제:
#   rm .git/hooks/pre-push
# 이번 한 번만 건너뛰기:
#   git push --no-verify
#
# 검사가 잡는 것은 형식·조합 규칙·내부 모순·치환 후 출력이다.
# 임상 내용이 맞는지는 사람이 봐야 하며 이 훅이 대신해 주지 않는다.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
script="$root/cpx/tools/check_all.py"
[ -f "$script" ] || exit 0

# 카드나 도구가 바뀌지 않았으면 굳이 돌리지 않는다.
if git diff --cached --name-only 2>/dev/null | grep -qv . ; then :; fi
changed=$(git diff --name-only "@{push}" HEAD 2>/dev/null || git diff --name-only HEAD~1 HEAD 2>/dev/null)
if [ -n "$changed" ] && ! printf '%s\n' "$changed" | grep -q "cpx/skills/start/refs/cases\|cpx/tools\|\.claude-plugin"; then
  exit 0
fi

# sample_case.py 는 별도 저장소(cpx-worker)의 src/sampleCase.js 로 손으로 포팅돼 있고
# 자동 동기화가 없다(양쪽 파일 상단 주석 참고). 여기서 고치면 저쪽도 같이 볼 것 —
# 놓치면 플러그인과 웹 면담이 서로 다른 규칙으로 케이스를 뽑게 된다.
if printf '%s\n' "$changed" | grep -q "cpx/tools/sample_case\.py"; then
  echo "⚠️  sample_case.py 가 바뀌었습니다 — cpx-worker/src/sampleCase.js 도 같이 고쳤는지 확인하세요."
fi

for py in python python3 py; do
  command -v "$py" >/dev/null 2>&1 && { PY="$py"; break; }
done
[ -n "$PY" ] || { echo "python 을 찾지 못해 카드 점검을 건너뜁니다."; exit 0; }

echo "카드 점검 중..."
"$PY" "$script" 10 --quiet || {
  echo ""
  echo "카드 점검에 실패해 푸시를 멈췄습니다."
  echo "  자세히 보기: $PY cpx/tools/check_all.py 10"
  echo "  그래도 올리려면: git push --no-verify"
  exit 1
}
exit 0
